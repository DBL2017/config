{
    "mcpServers": {
        "obsidian": {
            "command": "mcp-remote",
            "args": [
                "http://192.168.100.1:27123/mcp/",
                "--allow-http",
                "--header",
                "Authorization: Bearer ${AUTH_TOKEN}"
            ],
            "env": {
                "AUTH_TOKEN": "${OBSIDIAN_API_KEY}"
            }
        },
        "zotero-mcp": {
            "command": "mcp-remote",
            "args": [
                "http://192.168.100.1:23120/mcp/",
                "--allow-http"
            ]
        }
    }
}
